# ============================================================================
# DreamHarbour Project - .gitignore
# ============================================================================
# Professional Git ignore configuration for DreamHarbour
# Version: 1.0.0 | Last Updated: 2025-11-30
# This file specifies which files and directories Git should ignore
# Never commit secrets, dependencies, or sensitive data!

# ============================================================================
# SECTION 1: ENVIRONMENT & SECRETS - CRITICAL (NEVER COMMIT!)
# ============================================================================
# Environment variables containing API keys, database credentials, etc.
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local

# Configuration files with secrets
config/secrets.json
config/credentials.json
.supabase/secrets.json

# Common secret file patterns
**/secrets
**/secrets/**
secrets.* 
private-keys/
private-keys/**

# ============================================================================
# SECTION 2: DEPENDENCIES & PACKAGE MANAGERS
# ============================================================================
# Node.js / NPM dependencies
node_modules/
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager lock files
package-lock.json
yarn.lock
pnpm-lock.yaml
shrinkwrap.yaml

# Dependency cache
.npm/
.yarn/cache/
.yarn/install-state.gz

# ============================================================================
# SECTION 3: IDE & EDITOR CONFIGURATION
# ============================================================================
# Visual Studio Code
.vscode/
.vscode/settings.json
.vscode/extensions.json
.vscode/launch.json
.vscode/tasks.json
.vscode/c_cpp_properties.json

# Sublime Text
*.sublime-project
*.sublime-workspace
.sublime-grunt.cache

# JetBrains IDEs (WebStorm, IntelliJ IDEA, etc.)
.idea/
*.iml
*.iws
*.ipr
*.idl
out/
.gradle/

# Visual Studio
.vs/
.vscode-fold
*.vscodeignore

# Vim
*.swp
*.swo
*~
.vim/
.*.swp
.*.swo

# Emacs
*~
\#*\#
.\#*
*-autosave.el

# Atom
.atom/
.atomignore

# VS Live Share
.vsls.json

# ============================================================================
# SECTION 4: OPERATING SYSTEM SPECIFIC FILES
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.DocumentRevisions-V100
.fseventsd
.TemporaryItems

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
[Dd]esktop.ini
[Ss]ystem Volume Information
$RECYCLE.BIN/
*.cab

# Linux
.directory
.Trash-*
.kde/
.gnome2/

# ============================================================================
# SECTION 5: BUILD & DISTRIBUTION
# ============================================================================
# Build outputs
dist/
build/
/dist
/build
*.dist

# Compiled files
*.o
*.a
*.so
*.dylib
*.exe
*.dll

# Cache directories
.cache/
.eslintcache
.stylelintcache
.prettier-ignore
.sass-cache/

# Webpack/Build tool outputs
webpack-stats.json

# ============================================================================
# SECTION 6: LOGS & DEBUG FILES
# ============================================================================
# Log files
*.log
*.log.*
logs/
log/
debug.log
lerna-debug.log
npm-debug.log
yarn-error.log
pnpm-error.log

# Debug directories
.debug/
debug/

# ============================================================================
# SECTION 7: TEMPORARY & BACKUP FILES
# ============================================================================
# Temporary files
*.tmp
*.temp
*.tmp.*
*.swp
*.swo
*~
.*.sw*

# Backup files
*.backup
*.bak
*.backup.*
*-backup
*-backup/
backup/

# Auto-save files
*-autosave.*
*.recovered.*

# ============================================================================
# SECTION 8: DATABASE & DATA FILES
# ============================================================================
# Local databases (if any)
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
database.json
local-db/
.db/

# Data files
data/
data/**
*.csv
*.xlsx
*.xls
*.tsv

# Database backups
*.sql
*.sql.gz
database-backup/

# ============================================================================
# SECTION 9: TEST FILES & COVERAGE
# ============================================================================
# Test results
coverage/
.nyc_output/
test-results/
test-report/
*.test.log
.coverage/
*.lcov

# Test temporary files
/test-tmp
/e2e-tmp

# ============================================================================
# SECTION 10: SENSITIVE & PRIVATE DATA
# ============================================================================
# API keys and credentials
**/api-keys.txt
**/api-keys/**
**/credentials.json
**/credentials/**
**/secrets.*
**/private-key.*
**/private-keys/
supabase-keys.txt
firebase-credentials.json

# User data and PII
users/
user-data/
private/
private/**
secure/
secure/**

# Payment & financial data
payments/
invoices/invoice-data/
financial-data/

# ============================================================================
# SECTION 11: BUILD & DOCUMENTATION
# ============================================================================
# Documentation builds
docs/_build/
docs/build/
site/
.vuepress/dist/

# Auto-generated files
*.generated.ts
*.generated.js
*.d.ts

# ============================================================================
# SECTION 12: DEPENDENCY-RELATED
# ============================================================================
# Bundler gems
*.gem
Gemfile.lock

# Ruby
.bundle/
vendor/bundle/
vendor/gems/

# ============================================================================
# SECTION 13: PROJECT SPECIFIC - DreamHarbour
# ============================================================================
# Browser sync
.browsersyncignore

# Exported files
exports/
*.pdf
reports/
report-data/

# Uploads (if file upload feature added)
uploads/
uploads/**
temp/
temp/**
tmp/
tmp/**
.uploads/

# Invoice exports
invoice-exports/
invoice-pdfs/

# System files
.system/
.config/

# ============================================================================
# SECTION 14: RUNTIME ARTIFACTS
# ============================================================================
# PID files
*.pid
*.seed
*.pid.lock

# Runtime data
pids/
*.pem

# ============================================================================
# SECTION 15: EXCEPTIONS - FORCE INCLUDE IMPORTANT FILES
# ============================================================================
# Override gitignore for important files that must be tracked
!.gitkeep
!.env.example
!.env.sample
!.env.template
!README.md
!.gitignore
!LICENSE
!package.json
!.nvmrc
!.prettierrc
!.eslintrc*
!jest.config.js

# ============================================================================
# END OF .gitignore
# ============================================================================